{
  "name": "Smart Camera",
  "short_name": "Smart Camera",
  "description": "On-device AI photography assistant. Pose, composition, zoom and lighting guidance with automatic capture. Everything runs locally in your browser.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
  "background_color": "#0b0b0f",
  "theme_color": "#0b0b0f",
  "lang": "en",
  "dir": "ltr",
  "categories": ["photo", "utilities"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Smart Pose", "short_name": "Pose", "url": "./?mode=pose", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Smart Photo", "short_name": "Photo", "url": "./?mode=photo", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "prefer_related_applications": false
}
